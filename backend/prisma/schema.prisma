  feeAmount   Decimal                 @db.Decimal(14, 2)
  netAmount   Decimal                 @db.Decimal(14, 2)
  settledAt   DateTime
  createdAt   DateTime                @default(now())
  business    Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy   User                    @relation("SettlementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines       GatewaySettlementLine[]

  @@unique([businessId, provider, reference])
  @@index([businessId, settledAt])
}

model GatewaySettlementLine {
  id           String            @id @default(cuid())
  settlementId String
  paymentId    String
  grossAmount  Decimal           @db.Decimal(14, 2)
  feeAmount    Decimal           @db.Decimal(14, 2)
  settlement   GatewaySettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  payment      Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId])
  @@index([settlementId])
}
