generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

model ProductReview {
  id         String   @id @default(cuid())
  businessId String
  productId  String
  customerId String
  rating     Int
  comment    String?  @db.VarChar(2000)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([productId, customerId])
  @@index([businessId, productId, createdAt])
  @@index([customerId, createdAt])
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum StaffAccessRole {
  CASHIER
  SENIOR_STAFF
}

enum ProductState {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductImageView {
  FRONT
  BACK
  SIDE
  ADDITIONAL
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  EXPIRY
  THEFT
  ADJUSTMENT
}

enum PurchaseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum SaleChannel {
  POS
  ONLINE
  MANUAL
}

enum CustomerType {
  PERSONAL
  COMPANY
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  REVERSED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  OTHER
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum OnlineOrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  PAID
  PROCESSING
  READY_FOR_COLLECTION
  DISPATCHED
  DELIVERED
  COLLECTED
  PARTIALLY_FULFILLED
  CANCELLED
  RETURN_REQUESTED
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REJECTED
}

enum StockCondition {
  GOOD
  DAMAGED
  QUARANTINED
  EXPIRED
}

enum DeliveryChannel {
  EMAIL
  SMS
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SUPPRESSED
}

enum InstallmentAgreementStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Business {
  id                    String                 @id @default(cuid())
  name                  String
  storeSlug             String                 @unique @db.VarChar(80)
  currency              String                 @default("NGN") @db.VarChar(3)
  timezone              String                 @default("Africa/Lagos")
  onlineDeliveryEnabled Boolean                @default(true)
  onlineDeliveryFee     Decimal                @default(4500) @db.Decimal(14, 2)
  payOnPickupEnabled    Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  users                 User[]
  branches              Branch[]
  products              Product[]
  productReviews        ProductReview[]
  categories            Category[]
  mediaAssets           MediaAsset[]
  suppliers             Supplier[]
  customers             Customer[]
  customerAccounts      CustomerAccount[]
  purchaseOrders        PurchaseOrder[]
  supplierInvoices      SupplierInvoice[]
  payments              Payment[]
  sales                 Sale[]
  expenses              Expense[]
  cashShifts            CashShift[]
  accounts              Account[]
  journalEntries        JournalEntry[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  reservations          StockReservation[]
  onlineOrders          OnlineOrder[]
  stockTransfers        StockTransfer[]
  stockCounts           StockCount[]
  productMerges         ProductMerge[]
  supplierReturns       SupplierReturn[]
  settlements           GatewaySettlement[]
  installmentAgreements InstallmentAgreement[]
  installmentPayments   InstallmentPayment[]
  installmentRefunds    InstallmentRefund[]
}

model Branch {
  id                    String                 @id @default(cuid())
  businessId            String
  name                  String
  address               String?
  isDefault             Boolean                @default(false)
  isPickupLocation      Boolean                @default(false)
  createdAt             DateTime               @default(now())
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  balances              StockBalance[]
  assignedStaff         User[]                 @relation("StaffAssignedBranch")
  stockLots             StockLot[]
  movements             StockMovement[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  sales                 Sale[]
  onlineOrders          OnlineOrder[]
  transfersOut          StockTransfer[]        @relation("TransferSource")
  transfersIn           StockTransfer[]        @relation("TransferDestination")
  stockCounts           StockCount[]
  supplierReturns       SupplierReturn[]
  cashShifts            CashShift[]
  expenses              Expense[]
  reservations          StockReservation[]
  installmentAgreements InstallmentAgreement[]

  @@unique([businessId, name])
  @@index([businessId])
}

model User {
  id                           String                 @id @default(cuid())
  businessId                   String
  branchId                     String?
  email                        String
  name                         String
  passwordHash                 String
  role                         UserRole               @default(STAFF)
  staffAccessRole              StaffAccessRole?
  mustChangePassword           Boolean                @default(false)
  isActive                     Boolean                @default(true)
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  business                     Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch                       Branch?                @relation("StaffAssignedBranch", fields: [branchId], references: [id], onDelete: Restrict)
  sessions                     Session[]
  movements                    StockMovement[]
  products                     Product[]              @relation("ProductCreator")
  createdPurchaseOrders        PurchaseOrder[]        @relation("PurchaseCreator")
  approvedPurchaseOrders       PurchaseOrder[]        @relation("PurchaseApprover")
  goodsReceipts                GoodsReceipt[]
  sales                        Sale[]
  saleReturns                  SaleReturn[]
  stockTransfersCreated        StockTransfer[]        @relation("TransferCreator")
  stockTransfersApproved       StockTransfer[]        @relation("TransferApprover")
  stockTransfersReceived       StockTransfer[]        @relation("TransferReceiver")
  stockCountsCreated           StockCount[]           @relation("StockCountCreator")
  stockCountsApproved          StockCount[]           @relation("StockCountApprover")
  stockCountsPosted            StockCount[]           @relation("StockCountPoster")
  refunds                      Refund[]
  installmentAgreementsCreated InstallmentAgreement[]
  installmentRefunds           InstallmentRefund[]
  cashShifts                   CashShift[]
  expenses                     Expense[]
  journalEntries               JournalEntry[]         @relation("JournalCreator")
  auditLogs                    AuditLog[]
  notifications                Notification[]
  productMerges                ProductMerge[]
  supplierReturns              SupplierReturn[]
  settlementsCreated           GatewaySettlement[]    @relation("SettlementCreator")

  // Login currently uses email alone; keep it globally unique until a business selector is introduced.
  @@unique([email])
  @@index([email])
}

model Session {
  id            String         @id @default(cuid())
  tokenHash     String         @unique
  userId        String
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  sessionId String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
  @@index([expiresAt])
}

model Product {
  id                  String                     @id @default(cuid())
  businessId          String
  sku                 String                     @db.VarChar(80)
  barcode             String?                    @db.VarChar(80)
  name                String                     @db.VarChar(180)
  normalizedName      String                     @db.VarChar(180)
  description         String?
  brand               String?                    @db.VarChar(120)
  model               String?                    @db.VarChar(120)
  category            String                     @db.VarChar(100)
  subcategory         String?                    @db.VarChar(100)
  categoryId          String?
  subcategoryId       String?
  unit                String                     @default("piece") @db.VarChar(40)
  costPrice           Decimal                    @default(0) @db.Decimal(14, 2)
  bottomPrice         Decimal                    @default(0) @db.Decimal(14, 2)
  sellingPrice        Decimal                    @db.Decimal(14, 2)
  originalPrice       Decimal?                   @db.Decimal(14, 2)
  reorderLevel        Decimal                    @default(0) @db.Decimal(14, 3)
  state               ProductState               @default(DRAFT)
  isPublished         Boolean                    @default(false)
  imageUrl            String?
  imagePublicId       String?
  createdById         String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  business            Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  categoryRecord      Category?                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryRecord   Subcategory?               @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  createdBy           User                       @relation("ProductCreator", fields: [createdById], references: [id], onDelete: Restrict)
  balances            StockBalance[]
  stockLots           StockLot[]
  mediaAssets         MediaAsset[]
  productImages       ProductImage[]
  specifications      ProductSpecification[]
  movements           StockMovement[]
  purchaseOrderLines  PurchaseOrderLine[]
  receiptLines        GoodsReceiptLine[]
  saleLines           SaleLine[]
  saleReturnLines     SaleReturnLine[]
  onlineOrderLines    OnlineOrderLine[]
  reviews             ProductReview[]
  transferLines       StockTransferLine[]
  countLines          StockCountLine[]
  reservations        StockReservation[]
  supplierReturnLines SupplierReturnLine[]
  installmentLines    InstallmentAgreementLine[]
  mergedIntoId        String?
  mergedInto          Product?                   @relation("ProductMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedProducts      Product[]                  @relation("ProductMerge")
  mergesAsSource      ProductMerge[]             @relation("MergeSource")
  mergesAsTarget      ProductMerge[]             @relation("MergeTarget")

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([businessId, state, name])
  @@index([businessId, normalizedName])
}

model Category {
  id             String        @id @default(cuid())
  businessId     String
  name           String        @db.VarChar(100)
  normalizedName String        @db.VarChar(100)
  createdAt      DateTime      @default(now())
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  subcategories  Subcategory[]
  products       Product[]

  @@unique([businessId, normalizedName])
  @@index([businessId, name])
}

model Subcategory {
  id             String    @id @default(cuid())
  categoryId     String
  name           String    @db.VarChar(100)
  normalizedName String    @db.VarChar(100)
  createdAt      DateTime  @default(now())
  category       Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products       Product[]

  @@unique([categoryId, normalizedName])
  @@index([categoryId, name])
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  name      String   @db.VarChar(100)
  value     String   @db.VarChar(500)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId])
}

model MediaAsset {
  id               String        @id @default(cuid())
  businessId       String
  productId        String?
  ownerId          String?       @db.VarChar(255)
  purpose          String        @db.VarChar(40)
  resourceType     String        @db.VarChar(10)
  folder           String        @db.VarChar(255)
  secureUrl        String?       @db.Text
  publicId         String        @unique @db.VarChar(255)
  originalFilename String?       @db.VarChar(255)
  mimeType         String?       @db.VarChar(120)
  status           String        @default("UPLOADING") @db.VarChar(20)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product          Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productImage     ProductImage?

  @@index([businessId, purpose, status])
  @@index([productId, status])
}

model ProductImage {
  id           String           @id @default(cuid())
  productId    String
  mediaAssetId String           @unique
  view         ProductImageView
  position     Int              @default(0)
  isPrimary    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([productId, view, position])
  @@index([productId, view, position])
}

model StockBalance {
  productId String
  branchId  String
  onHand    Decimal  @default(0) @db.Decimal(14, 3)
  reserved  Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([productId, branchId])
  @@index([branchId])
}

model StockLot {
  id                  String                @id @default(cuid())
  productId           String
  branchId            String
  sourceReceiptLineId String?               @unique
  batchNumber         String?               @db.VarChar(100)
  expiresAt           DateTime?
  unitCost            Decimal               @db.Decimal(14, 2)
  quantity            Decimal               @default(0) @db.Decimal(14, 3)
  reserved            Decimal               @default(0) @db.Decimal(14, 3)
  origin              String                @default("OPENING") @db.VarChar(30)
  condition           StockCondition        @default(GOOD)
  createdAt           DateTime              @default(now())
  product             Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch              Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sourceReceiptLine   GoodsReceiptLine?     @relation(fields: [sourceReceiptLineId], references: [id], onDelete: Restrict)
  saleAllocations     SaleLotAllocation[]
  returnAllocations   ReturnLotAllocation[]
  reservationLots     ReservationLot[]

  @@index([productId, branchId, expiresAt, createdAt])
}

model SaleLotAllocation {
  id         String   @id @default(cuid())
  saleLineId String
  stockLotId String
  quantity   Decimal  @db.Decimal(14, 3)
  unitCost   Decimal  @db.Decimal(14, 2)
  saleLine   SaleLine @relation(fields: [saleLineId], references: [id], onDelete: Restrict)
  stockLot   StockLot @relation(fields: [stockLotId], references: [id], onDelete: Restrict)

  @@index([saleLineId])
  @@index([stockLotId])
}

model ReturnLotAllocation {
  id               String         @id @default(cuid())
  saleReturnLineId String
  stockLotId       String
  quantity         Decimal        @db.Decimal(14, 3)
  unitCost         Decimal        @db.Decimal(14, 2)
  saleReturnLine   SaleReturnLine @relation(fields: [saleReturnLineId], references: [id], onDelete: Restrict)
  stockLot         StockLot       @relation(fields: [stockLotId], references: [id], onDelete: Restrict)

  @@index([saleReturnLineId])
}

model StockMovement {
  id         String            @id @default(cuid())
  productId  String
  branchId   String
  userId     String?
  actorType  String            @default("USER") @db.VarChar(30)
  type       StockMovementType
  quantity   Decimal           @db.Decimal(14, 3)
  unitCost   Decimal?          @db.Decimal(14, 2)
  reference  String?
  reason     String?
  reversalOf String?
  createdAt  DateTime          @default(now())
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch     Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user       User?             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([productId, branchId, createdAt])
  @@index([branchId, createdAt])
  @@index([userId, createdAt])
}

model StockTransfer {
  id                  String              @id @default(cuid())
  businessId          String
  sourceBranchId      String
  destinationBranchId String
  createdById         String
  approvedById        String?
  receivedById        String?
  reference           String              @unique @db.VarChar(50)
  status              TransferStatus      @default(DRAFT)
  notes               String?
  expectedArrivalAt   DateTime?
  createdAt           DateTime            @default(now())
  dispatchedAt        DateTime?
  receivedAt          DateTime?
  business            Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sourceBranch        Branch              @relation("TransferSource", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  destinationBranch   Branch              @relation("TransferDestination", fields: [destinationBranchId], references: [id], onDelete: Restrict)
  createdBy           User                @relation("TransferCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy          User?               @relation("TransferApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  receivedBy          User?               @relation("TransferReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  lines               StockTransferLine[]

  @@index([businessId, status, createdAt])
}

model StockTransferLine {
  id                String             @id @default(cuid())
  transferId        String
  productId         String
  quantity          Decimal            @db.Decimal(14, 3)
  receivedQuantity  Decimal?           @db.Decimal(14, 3)
  discrepancyReason String?
  transfer          StockTransfer      @relation(fields: [transferId], references: [id], onDelete: Restrict)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  lots              StockTransferLot[]

  @@index([transferId])
}

model StockTransferLot {
  id             String            @id @default(cuid())
  transferLineId String
  batchNumber    String?           @db.VarChar(100)
  expiresAt      DateTime?
  unitCost       Decimal           @db.Decimal(14, 2)
  quantity       Decimal           @db.Decimal(14, 3)
  transferLine   StockTransferLine @relation(fields: [transferLineId], references: [id], onDelete: Restrict)

  @@index([transferLineId])
}

model StockCount {
  id           String           @id @default(cuid())
  businessId   String
  branchId     String
  createdById  String
  approvedById String?
  postedById   String?
  reference    String           @unique @db.VarChar(50)
  status       StockCountStatus @default(DRAFT)
  reason       String?
  createdAt    DateTime         @default(now())
  submittedAt  DateTime?
  approvedAt   DateTime?
  postedAt     DateTime?
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy    User             @relation("StockCountCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?            @relation("StockCountApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  postedBy     User?            @relation("StockCountPoster", fields: [postedById], references: [id], onDelete: Restrict)
  lines        StockCountLine[]

  @@index([businessId, status, createdAt])
}

model StockCountLine {
  id              String     @id @default(cuid())
  stockCountId    String
  productId       String
  systemQuantity  Decimal    @db.Decimal(14, 3)
  countedQuantity Decimal    @db.Decimal(14, 3)
  variance        Decimal    @db.Decimal(14, 3)
  stockCount      StockCount @relation(fields: [stockCountId], references: [id], onDelete: Restrict)
  product         Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, productId])
}

model Supplier {
  id               String            @id @default(cuid())
  businessId       String
  name             String            @db.VarChar(180)
  phone            String?           @db.VarChar(40)
  email            String?           @db.VarChar(254)
  address          String?
  paymentTermsDays Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  purchaseOrders   PurchaseOrder[]
  invoices         SupplierInvoice[]
  returns          SupplierReturn[]

  @@index([businessId, name])
}

model Customer {
  id                    String                 @id @default(cuid())
  businessId            String
  name                  String                 @db.VarChar(180)
  type                  CustomerType           @default(PERSONAL)
  companyName           String?                @db.VarChar(180)
  contactPerson         String?                @db.VarChar(180)
  isCreditor            Boolean                @default(false)
  phone                 String?                @db.VarChar(40)
  email                 String?                @db.VarChar(254)
  address               String?
  avatarUrl             String?
  creditLimit           Decimal?               @db.Decimal(14, 2)
  creditDays            Int                    @default(30)
  emailRemindersAllowed Boolean                @default(false)
  smsRemindersAllowed   Boolean                @default(false)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sales                 Sale[]
  onlineOrders          OnlineOrder[]
  account               CustomerAccount?
  productReviews        ProductReview[]
  installmentAgreements InstallmentAgreement[]

  @@index([businessId, name])
  @@index([businessId, phone])
}

model CustomerAccount {
  id              String                 @id @default(cuid())
  businessId      String
  customerId      String                 @unique
  email           String                 @db.VarChar(254)
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  business        Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer        Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sessions        CustomerSession[]
  tokens          CustomerAccountToken[]

  @@unique([businessId, email])
  @@index([businessId, createdAt])
}

model CustomerAccountToken {
  id                String          @id @default(cuid())
  customerAccountId String
  tokenHash         String          @unique
  purpose           String          @db.VarChar(30)
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime        @default(now())
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, purpose, expiresAt])
}

model EmailOutbox {
  id            String    @id @default(cuid())
  businessId    String
  kind          String    @db.VarChar(40)
  destination   String    @db.VarChar(254)
  subject       String    @db.VarChar(180)
  text          String
  html          String
  status        String    @default("PENDING") @db.VarChar(20)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([businessId, createdAt])
}

model CustomerSession {
  id                String          @id @default(cuid())
  customerAccountId String
  tokenHash         String          @unique
  expiresAt         DateTime
  createdAt         DateTime        @default(now())
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, expiresAt])
  @@index([expiresAt])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  businessId   String
  branchId     String
  supplierId   String
  createdById  String
  approvedById String?
  number       String              @db.VarChar(40)
  status       PurchaseStatus      @default(DRAFT)
  expectedAt   DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  submittedAt  DateTime?
  approvedAt   DateTime?
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User                @relation("PurchaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?               @relation("PurchaseApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  lines        PurchaseOrderLine[]
  receipts     GoodsReceipt[]
  invoices     SupplierInvoice[]

  @@unique([businessId, number])
  @@index([businessId, status, createdAt])
  @@index([supplierId, createdAt])
}

model PurchaseOrderLine {
  id              String             @id @default(cuid())
  purchaseOrderId String
  productId       String
  orderedQuantity Decimal            @db.Decimal(14, 3)
  unitCost        Decimal            @db.Decimal(14, 2)
  createdAt       DateTime           @default(now())
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  product         Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptLines    GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  purchaseOrderId String
  branchId        String
  receivedById    String
  reference       String             @unique @db.VarChar(50)
  notes           String?
  receivedAt      DateTime           @default(now())
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  branch          Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  receivedBy      User               @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  lines           GoodsReceiptLine[]
  invoice         SupplierInvoice?

  @@index([purchaseOrderId, receivedAt])
}

model GoodsReceiptLine {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderLineId String
  productId           String
  acceptedQuantity    Decimal           @db.Decimal(14, 3)
  rejectedQuantity    Decimal           @default(0) @db.Decimal(14, 3)
  unitCost            Decimal           @db.Decimal(14, 2)
  batchNumber         String?
  expiresAt           DateTime?
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  product             Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockLot            StockLot?

  @@index([goodsReceiptId])
}

model SupplierInvoice {
  id              String                      @id @default(cuid())
  businessId      String
  supplierId      String
  purchaseOrderId String?
  goodsReceiptId  String?                     @unique
  invoiceNumber   String                      @db.VarChar(80)
  totalAmount     Decimal                     @db.Decimal(14, 2)
  dueAt           DateTime?
  issuedAt        DateTime                    @default(now())
  createdAt       DateTime                    @default(now())
  business        Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplier        Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  goodsReceipt    GoodsReceipt?               @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  allocations     SupplierPaymentAllocation[]
  returns         SupplierReturn[]

  @@unique([businessId, supplierId, invoiceNumber])
  @@index([businessId, dueAt])
}

model Sale {
  id              String                  @id @default(cuid())
  businessId      String
  branchId        String
  userId          String?
  actorType       String                  @default("USER") @db.VarChar(30)
  customerId      String?
  number          String                  @db.VarChar(40)
  channel         SaleChannel             @default(POS)
  status          SaleStatus              @default(COMPLETED)
  subtotal        Decimal                 @db.Decimal(14, 2)
  discount        Decimal                 @default(0) @db.Decimal(14, 2)
  tax             Decimal                 @default(0) @db.Decimal(14, 2)
  deliveryFee     Decimal                 @default(0) @db.Decimal(14, 2)
  total           Decimal                 @db.Decimal(14, 2)
  dueAt           DateTime?
  creditReference String?                 @db.VarChar(100)
  idempotencyKey  String?
  createdAt       DateTime                @default(now())
  business        Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch          Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user            User?                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer        Customer?               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines           SaleLine[]
  payments        SalePaymentAllocation[]
  reservations    StockReservation[]
  returns         SaleReturn[]
  refunds         Refund[]
  cashShiftId     String?
  cashShift       CashShift?              @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)

  @@unique([businessId, number])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([branchId, createdAt])
  @@index([customerId, createdAt])
}

model SaleLine {
  id             String              @id @default(cuid())
  saleId         String
  productId      String
  productName    String              @db.VarChar(180)
  sku            String              @db.VarChar(80)
  quantity       Decimal             @db.Decimal(14, 3)
  unitPrice      Decimal             @db.Decimal(14, 2)
  unitCost       Decimal             @db.Decimal(14, 2)
  discount       Decimal             @default(0) @db.Decimal(14, 2)
  tax            Decimal             @default(0) @db.Decimal(14, 2)
  lineTotal      Decimal             @db.Decimal(14, 2)
  sale           Sale                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  returns        SaleReturnLine[]
  lotAllocations SaleLotAllocation[]

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id                  String                      @id @default(cuid())
  businessId          String
  method              PaymentMethod
  status              PaymentStatus               @default(PENDING)
  amount              Decimal                     @db.Decimal(14, 2)
  fee                 Decimal                     @default(0) @db.Decimal(14, 2)
  provider            String?
  providerReference   String?
  reference           String                      @db.VarChar(80)
  idempotencyKey      String?
  paidAt              DateTime?
  createdAt           DateTime                    @default(now())
  business            Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  saleAllocations     SalePaymentAllocation[]
  onlineOrder         OnlineOrder?                @relation(fields: [onlineOrderId], references: [id], onDelete: Restrict)
  onlineOrderId       String?
  supplierAllocations SupplierPaymentAllocation[]
  expense             Expense?
  providerEvents      PaymentProviderEvent[]
  settlementLines     GatewaySettlementLine[]
  installmentPayment  InstallmentPayment?

  @@unique([businessId, reference])
  @@unique([businessId, idempotencyKey])
  @@unique([provider, providerReference])
  @@index([businessId, status, createdAt])
}

model InstallmentAgreement {
  id               String                     @id @default(cuid())
  businessId       String
  branchId         String
  customerId       String
  createdById      String
  number           String                     @db.VarChar(50)
