# Migration task only. DATABASE_URL is required by the Prisma schema and should
# use the Neon pooled host; DIRECT_URL is used by Prisma Migrate over the direct host.
DATABASE_URL=postgresql://RUNTIME_USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
DIRECT_URL=postgresql://MIGRATION_USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require&connect_timeout=30
