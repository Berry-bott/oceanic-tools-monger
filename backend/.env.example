NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Use the pooled connection string for API traffic; Neon host includes -pooler.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
SESSION_COOKIE_NAME=oceanic_session
# Administrator access cookie lifetime and rotating refresh cookie lifetime.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_COOKIE_NAME=oceanic_refresh
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_ROTATION_GRACE_SECONDS=15
# Customer storefront session lifetime (separate from administrator sessions).
SESSION_TTL_DAYS=7
COOKIE_SAME_SITE=none
PAYSTACK_SECRET_KEY=sk_test_replace_me
STORE_PAYMENT_CALLBACK_URL=http://localhost:3000/checkout/confirmation
RESEND_API_KEY=re_replace_me
REMINDER_FROM_EMAIL=Oceanic Tools <billing@example.com>
# Public frontend base URL used to build customer verification and password reset links.
CUSTOMER_ACCOUNT_BASE_URL=http://localhost:3000
TERMII_API_KEY=replace_me
TERMII_SENDER_ID=Oceanic
# Optional; use the API host assigned in the Termii dashboard.
TERMII_API_URL=https://api.ng.termii.com/api/sms/send
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-unique-password-at-least-12-characters
OWNER_NAME=Business Owner
BUSINESS_NAME=Oceanic Market
BUSINESS_SLUG=oceanic-market
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional per-category upload limits in bytes; defaults are 5 MB / 50 MB / 10 MB.
CLOUDINARY_IMAGE_MAX_BYTES=5242880
CLOUDINARY_VIDEO_MAX_BYTES=52428800
CLOUDINARY_DOCUMENT_MAX_BYTES=10485760
